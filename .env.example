# Підключення до PostgreSQL (у docker-compose база слухає порт 5433 на хості)
DATABASE_URL=postgresql+psycopg://carwash:carwash@localhost:5433/carwash

# Звідки дозволено запити з браузера (адреса Vite-клієнта з лаб 4)
FRONTEND_URL=http://localhost:5173

# Робочий день автомийки: слоти для запису генеруються в цих межах (за місцевим часом)
TIMEZONE=Europe/Kyiv
WORK_DAY_START=9
WORK_DAY_END=20
SLOT_STEP_MINUTES=30

# Адмін для scripts/seed.py (email має бути «справжнього» формату: .local не підходить)
SEED_ADMIN_EMAIL=admin@example.com
# Пароль адміна для scripts/seed.py (лише для локальної розробки!)
SEED_ADMIN_PASSWORD=change-me-please

# --- Лабораторна 2 ---
APP_ENV=development
# Секрети згенеруйте самі: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-access-secret-0123456789abcdef
REFRESH_TOKEN_SECRET=change-me-refresh-secret-0123456789abcdef
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=7

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_AUTH=10

# --- Лабораторна 3 ---
# Redis для Socket.IO на кількох копіях сервера (необов'язково): redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0
# Додаткові origin-и для WebSocket (демо-сторінка /demo відкривається з самого бекенду)
EXTRA_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
SLOW_QUERY_MS=200
CACHE_TTL_SECONDS=60
EVENTS_RETENTION_DAYS=7

# Ліміт вхідних подій WebSocket на одне з'єднання
WS_RATE_LIMIT_EVENTS=30
WS_RATE_LIMIT_WINDOW_SECONDS=10

# Якщо задано, /metrics вимагає заголовок Authorization: Bearer <токен>
# METRICS_TOKEN=change-me

# Автоматичні «тихі години» за історією записів
AUTO_PRICING_ENABLED=false
AUTO_PRICING_INTERVAL_HOURS=24
AUTO_PRICING_WEEKS=8
AUTO_PRICING_MIN_BOOKINGS=30
AUTO_QUIET_THRESHOLD=0.30
AUTO_DISCOUNT_MAX=15
AUTO_DISCOUNT_STEP=5
