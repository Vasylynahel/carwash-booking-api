# Підключення до PostgreSQL (у docker-compose база слухає порт 5433 на хості)
DATABASE_URL=postgresql+psycopg://carwash:carwash@localhost:5433/carwash

# Звідки дозволено запити з браузера (адреса Vite-клієнта з лаб 4)
FRONTEND_URL=http://localhost:5173

# Робочий день автомийки: слоти для запису генеруються в цих межах (за місцевим часом)
TIMEZONE=Europe/Kyiv
WORK_DAY_START=9
WORK_DAY_END=20
SLOT_STEP_MINUTES=30

# Адмін для scripts/seed.py (email має бути «справжнього» формату: .local не підходить)
SEED_ADMIN_EMAIL=admin@example.com
# Пароль адміна для scripts/seed.py (лише для локальної розробки!)
SEED_ADMIN_PASSWORD=change-me-please

# --- Лабораторна 2 ---
APP_ENV=development
# Секрети згенеруйте самі: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-access-secret-0123456789abcdef
REFRESH_TOKEN_SECRET=change-me-refresh-secret-0123456789abcdef
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=7

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_AUTH=10
